# ─── Database (Supabase) ───
# Dashboard → Settings → Database → Connection string
# Encode special characters in the password ($ → %24, @ → %40, etc.)
#
# Direct (recommended for local dev — faster than pooler, fewer queued connections):
# DATABASE_URL_DIRECT=postgresql://postgres:[PASSWORD]@db.bqfdcnbcqhasxylpnlfs.supabase.co:5432/postgres
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.bqfdcnbcqhasxylpnlfs.supabase.co:5432/postgres
#
# Optional: override app pool size (default 12 dev / 5 prod on tx pooler)
# DB_POOL_MAX=12
# Pooler — Session (5432) or Transaction (6543); this project uses aws-1:
# DATABASE_URL=postgresql://postgres.bqfdcnbcqhasxylpnlfs:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.bqfdcnbcqhasxylpnlfs.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=bqfdcnbcqhasxylpnlfs

# Supabase Storage — required on Vercel for contract/attachment uploads (server-side only)
# Dashboard → Storage → New bucket → name: crm-uploads → Private
# Dashboard → Settings → API → service_role key (never expose to the browser)
SUPABASE_URL=https://bqfdcnbcqhasxylpnlfs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ-change-me-service-role-key
SUPABASE_STORAGE_BUCKET=crm-uploads

# App appends search_path=rm automatically — do not add public schema changes
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret
CRON_SECRET=change-me-cron-secret
CALLYZER_WEBHOOK_SECRET=change-me-callyzer
CALLYZER_API_TOKEN=change-me-callyzer-api-token
CALLYZER_API_BASE_URL=https://api1.callyzer.co/api/v2.1
WATI_WEBHOOK_SECRET=change-me-wati
NODE_ENV=development

# true = in-memory mock (no DB; commission/bookings APIs return empty). false = live Supabase
USE_MOCK_DATA=false

# After pulling schema changes: npm run db:migrate && npm run db:verify

# ─── Email ───
# Resend: automated ticket acknowledgement only (lib/resend.ts).
# Care agent replies: Gmail compose from care@ — not Resend.
#
# Resend dashboard → API Keys. olready.in must be verified (Domains).
# Send-only API keys cannot list domains but can send once verified.
RESEND_API_KEY=re_change-me-resend-api-key
RESEND_FROM_EMAIL=care@olready.in
# Reply-to on automated acks (usually same inbox care uses in Gmail)
CARE_GMAIL_ADDRESS=care@olready.in
# Legacy alias — prefer CARE_GMAIL_ADDRESS
# CARE_FROM_EMAIL=care@olready.in

# ─── AI (support / sales / grievance / RM) ───
OPENAI_API_KEY=sk-proj-change-me-openai-api-key
OPENAI_MODEL=gpt-4o
# Optional Claude fallback when OpenAI fails (tried second):
ANTHROPIC_API_KEY=sk-ant-change-me-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
